rom/
*.z64
*.n64
*.v64
*.zip
*.7z
assets/
build/
*.o
*.elf.tmp
asm/
bin/
*.ld
.venv/

# The permuter objective is normally build output. The exception is `target-draft.o`: it is OUR object, compiled
# from an earlier draft, and it is the evidence that the tool's objective was a proxy (M300/M302). The object
# built from the image's own words is cartridge code and stays ignored — `make_target.py` regenerates it.
!fixtures/permuter/p6/target-draft.o
fixtures/permuter/p6/target.o

# The synthetic corpus fixture is NOT cartridge data: 8 KiB of generated words, committed on purpose so the
# corpus pipeline can run without the real ROM (M129). The rules above keep actual cartridge images out; this
# one exception is size-checked by tools/ci.sh.
!fixtures/corpus/cart.z64

# Vendor SDK manuals are local reference (copyrighted Nintendo documents), like the ROM itself.
docs/*.pdf

# macOS Finder metadata. Tracked by accident since the first commit and churned on every directory open;
# the two files were removed from the index here, and this rule keeps them from coming back.
.DS_Store

# Python bytecode: these were tracked by accident, so every tool run churned 20+ files in `git status`, and a
# stale `.pyc` beside a rebuilt module is a cache the interpreter trusts before it reads the source. Neither belongs
# in the repository: they are derived artefacts of running the tools, never evidence (M373).
__pycache__/
*.pyc
